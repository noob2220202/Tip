# 검수 전용 봇의 토큰 (BotFather에서 새 봇을 만들어 받는다). 이 봇을 필수 채널의 "관리자"로 추가해야 한다.
BOT_TOKEN=
# 관리자 텔레그램 ID (쉼표로 여러 명)
ADMIN_IDS=
# 검수 서비스 비밀값. 다른 봇들의 .env에도 같은 값을 VERIFY_SECRET으로 넣는다.
# 길고 무작위인 값으로:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VERIFY_SECRET=
# 검수 서비스 포트. shared/config/common.toml의 verifier_url 포트와 같아야 한다 (127.0.0.1에서만 열린다).
VERIFY_PORT=8765
