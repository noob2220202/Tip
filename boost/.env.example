# BotFather에서 받은 토큰
BOT_TOKEN=
# 관리자 텔레그램 ID (쉼표로 여러 명). 수동 승인·알림을 받는다
ADMIN_IDS=
# 입금받을 TRON(TRC20) 지갑 주소. 이 지갑으로 들어온 USDT만 확인한다
WALLET_ADDRESS=
# TronGrid API 키 (https://www.trongrid.io 에서 발급). 키 없이도 되지만 호출 한도가 매우 낮다
TRONGRID_API_KEY=
# 기본값: https://api.trongrid.io
TRONGRID_URL=
# SMM 패널 API 주소와 키 (표준 API v2: key/action/service/link/quantity)
SMM_API_URL=
SMM_API_KEY=
# 입금 제한 시간(분), 입금 조회 주기(초). 기본값 30, 15
ORDER_TTL_MIN=30
POLL_SECONDS=15
# 채널 가입 검수 서비스 비밀값. verify/.env의 VERIFY_SECRET과 같은 값이어야 한다.
VERIFY_SECRET=
