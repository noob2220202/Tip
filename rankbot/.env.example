# 관리 봇 토큰 (BotFather에서 받은 것). 사용자가 여기서 자기 봇을 만든다
BOT_TOKEN=
# 관리자 텔레그램 ID (쉼표로 여러 명). 봇 개수 제한을 받지 않는다
ADMIN_IDS=
# 고객 봇 토큰을 DB에 암호화해 저장할 때 쓰는 키. 한 번 만들고 절대 바꾸거나 잃어버리면 안 된다
# 만들기: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=
# 사용자 한 명이 만들 수 있는 봇 수. 기본값 3
MAX_BOTS_PER_USER=3
# 채널 가입 검수 서비스 비밀값. verify/.env의 VERIFY_SECRET과 같은 값이어야 한다.
VERIFY_SECRET=
