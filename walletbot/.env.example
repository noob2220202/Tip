# BotFather에서 받은 토큰
BOT_TOKEN=
# 관리자 텔레그램 ID (쉼표로 여러 명). 오류 알림을 받는다
ADMIN_IDS=
# TronGrid API 키 (https://www.trongrid.io 에서 발급). 키 없이도 되지만 호출 한도가 매우 낮다
TRONGRID_API_KEY=
# 기본값: https://api.trongrid.io
TRONGRID_URL=
# 서버 전체에서 지켜볼 지갑 수 상한(같은 주소는 한 번만 센다). 기본값 500
# 블록 스캔은 지갑 수와 상관없이 하루 약 3만 요청이고, 잔액 대조가 지갑 수에 비례한다(아래 RECONCILE_MINUTES)
MAX_WALLETS_TOTAL=500
# 잔액 대조 간격(분). 블록 스캔이 못 잡는 입금(컨트랙트 경유)을 늦게라도 알리려고 주기적으로 잔액을 확인한다. 기본값 30
# 지갑이 1,000개를 넘으면 60으로 늘려 TronGrid 호출을 줄인다
RECONCILE_MINUTES=30
# 시세 출처 주소. 기본값은 빗썸(https://api.bithumb.com)과 무료 환율 API(https://open.er-api.com)
BITHUMB_URL=
FX_URL=
# 채널 가입 검수 서비스 비밀값. verify/.env의 VERIFY_SECRET과 같은 값이어야 한다.
VERIFY_SECRET=

# ── 에너지 임대 ──
# 손님이 TRX를 보낼 결제 주소(관리자 지갑). 봇은 이 주소로 들어오는 입금만 조회하고, 서버에 개인키를 두지 않는다.
# 비워 두면 에너지 임대 메뉴는 "준비 중"으로 보인다
ENERGY_PAY_ADDRESS=
# 주문 1건당 붙일 마진(TRX). 0이면 공급처 원가 그대로 판다(홍보용)
ENERGY_MARGIN_TRX=0
# 입금 뒤 공급처 원가가 받은 금액보다 이만큼(TRX) 넘게 비싸면 주문하지 않고 관리자에게 넘긴다. 기본값 1
ENERGY_MAX_LOSS_TRX=1
# 주문 후 입금 기한(분). 기본값 10
ENERGY_ORDER_MINUTES=10
# 공급처 잔고가 이보다 적으면 관리자에게 알린다(TRX). 기본값 50
ENERGY_LOW_BALANCE_TRX=50
# 공급처 API 키. 키가 있는 곳만 쓰고, 주문마다 가장 싼 곳을 고른다(거절되면 다음 곳)
# Netts: 대시보드 API 메뉴에서 키 발급 + 서버 공인 IP를 화이트리스트에 등록. NETTS_REAL_IP에 그 IP를 적는다
NETTS_API_KEY=
NETTS_REAL_IP=
# CatFee: 사용자 센터 → API에서 키·시크릿 발급
CATFEE_API_KEY=
CATFEE_API_SECRET=
# trxx: https://trxx.io/buyer/api 에서 키·시크릿 발급
TRXX_API_KEY=
TRXX_API_SECRET=
