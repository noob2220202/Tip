# BotFather에서 받은 토큰
BOT_TOKEN=
# 관리자 텔레그램 ID (쉼표로 여러 명). 오류 알림을 받는다
ADMIN_IDS=
# TronGrid API 키 (https://www.trongrid.io 에서 발급). 키 없이도 되지만 호출 한도가 매우 낮다
TRONGRID_API_KEY=
# 기본값: https://api.trongrid.io
TRONGRID_URL=
# 서버 전체에서 지켜볼 지갑 수 상한(같은 주소는 한 번만 센다). 기본값 30
# TronGrid 무료 키 한도(하루 약 10만 요청)를 넘지 않게 정한다
MAX_WALLETS_TOTAL=30
# 지갑 하나를 조회하는 간격(초). 기본값 60
POLL_SECONDS=60
# 시세 출처 주소. 기본값은 빗썸(https://api.bithumb.com)과 무료 환율 API(https://open.er-api.com)
BITHUMB_URL=
FX_URL=
# 채널 가입 검수 서비스 비밀값. verify/.env의 VERIFY_SECRET과 같은 값이어야 한다.
VERIFY_SECRET=
