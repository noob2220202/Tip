# BotFather에서 받은 토큰
BOT_TOKEN=
# 관리자 텔레그램 ID (쉼표로 여러 명). 이 계정만 이벤트를 만들고 실행할 수 있다. 추첨 대상에서는 빠진다
ADMIN_IDS=
# 채널 가입 검수 서비스 비밀값. verify/.env의 VERIFY_SECRET과 같은 값이어야 한다.
# 이벤트 참가 자격(채널 구독)은 shared/config/common.toml의 필수 채널을 기준으로 실행할 때마다 다시 확인한다
VERIFY_SECRET=
# 초당 발송 건수(기본 20). 텔레그램 제한(초당 약 30건)보다 낮게 둔다
SEND_PER_SEC=20
