# BotFather에서 받은 토큰
BOT_TOKEN=
# 관리자 텔레그램 ID (쉼표로 여러 명)
ADMIN_IDS=
# 카카오 로그인 세션 (kakaot의 `npm run login`으로 만든 session.json을 복사해 둔다)
# 움직이는 이모티콘을 받으려면 필요하다. 기본값: data/session.json
KAKAO_SESSION_PATH=
# 스티커마다 붙일 이모지 (텔레그램이 스티커마다 하나 이상 요구한다)
STICKER_EMOJI=😊
# 채널 가입 검수 서비스 비밀값. verify/.env의 VERIFY_SECRET과 같은 값이어야 한다.
VERIFY_SECRET=
# 동시에 변환하는 이모티콘 수(기본 1). 램이 4GB 이상이면 2로 올려도 된다
CONVERT_CONCURRENCY=1
# 영상 인코더(ffmpeg) 스레드 수(기본 2). 낮을수록 메모리와 CPU를 덜 쓴다
FFMPEG_THREADS=2
